/* ── SPIN LOADER COMPONENT ──────────────────────────────────
   Luma-style loader — two animated spans, inset keyframes.
   Used in the preload overlay when the user is NOT on the hero.
   Total duration: ~1100ms vs the full cinematic intro.
   ─────────────────────────────────────────────────────────── */

/* HTML:
  <div id="intro-spinner">
    <span></span>
    <span></span>
  </div>
*/

#intro-spinner {
  position: absolute;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  width: 65px; height: 65px;
  opacity: 0;
  animation: spinnerFadeIn 0.2s ease forwards;
}

@keyframes spinnerFadeIn {
  to { opacity: 1; }
}

#intro-spinner span {
  position: absolute;
  border-radius: 50px;
  box-shadow: inset 0 0 0 3px #2563EB;
  animation: lumaAnim 2.5s infinite;
}

#intro-spinner span:last-child {
  animation-delay: -1.25s;
}

@keyframes lumaAnim {
  0%    { inset: 0 35px 35px 0; }
  12.5% { inset: 0 35px 0    0; }
  25%   { inset: 35px 35px 0 0; }
  37.5% { inset: 35px 0    0 0; }
  50%   { inset: 35px 0    0 35px; }
  62.5% { inset: 0    0    0 35px; }
  75%   { inset: 0    0    35px 35px; }
  87.5% { inset: 0    0    35px 0; }
  100%  { inset: 0 35px 35px 0; }
}
